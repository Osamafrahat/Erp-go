# Client Environment Variables
VITE_API_URL=http://localhost:3001/api
VITE_APP_NAME=Store POS

# Sentry (Optional) - browser error reporting. No-op when empty.
# Build-time variable: Vite inlines it, so it must be set in the
# deployment's build environment (Vercel env var + redeploy).
# VITE_SENTRY_DSN=https://key@oNNN.ingest.us.sentry.io/NNN