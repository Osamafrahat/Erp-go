# Never bake environment files into the image.
.env
.env.*
*.env
!.env.example

# Dependencies and build output are produced inside the image.
node_modules
dist
npm-debug.log*

# VCS / editor / OS noise
.git
.gitignore
.vscode
.idea
.DS_Store
Thumbs.db

# Not needed at runtime
src/__tests__
coverage
vitest.config.js
