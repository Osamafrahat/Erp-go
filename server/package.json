{
  "name": "store-management-server",
  "version": "1.0.0",
  "description": "Backend API for Store Management POS System",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest --forceExit --detectOpenHandles",
    "test:unit": "NODE_OPTIONS='--experimental-vm-modules' jest --testPathPatterns='errorHandler' --forceExit",
    "test:integration": "NODE_OPTIONS='--experimental-vm-modules' jest --testPathPatterns='integration' --forceExit",
    "test:security": "node ../tests/security-audit.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.4",
    "axios": "^1.19.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.3",
    "resend": "^6.18.1",
    "stripe": "^22.5.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "jest": "^30.5.2",
    "supertest": "^7.2.2"
  }
}
