{
  "name": "store-management",
  "version": "1.0.0",
  "description": "Store Management POS & Stock System",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "start": "concurrently \"npm run server:prod\" \"npm run client:build\"",
    "server:prod": "cd server && npm start",
    "client:build": "cd client && npm run build",
    "backup": "cd server && node -e \"import('./src/services/backupService.js').then(b => b.backupToJson())\"",
    "backup:sql": "cd server && node -e \"import('./src/services/backupService.js').then(b => b.backupToSql())\"",
    "setup": "node setup.js",
    "backup:list": "cd server && node -e \"import('./src/services/backupService.js').then(b => b.listBackups().then(r => console.log(JSON.stringify(r, null, 2))))\"",
    "test": "concurrently \"npm run test:unit:client\" \"npm run test:unit:server\"",
    "test:unit:client": "cd client && npm test",
    "test:unit:server": "cd server && npm run test:unit",
    "test:integration": "cd server && npm run test:integration",
    "test:security": "node tests/security-audit.js",
    "test:load": "k6 run tests/load-test.js",
    "test:spike": "k6 run tests/spike-test.js",
    "audit": "npm audit --omit=dev && cd client && npm audit --omit=dev"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
